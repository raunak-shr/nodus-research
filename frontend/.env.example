# Copy to .env and fill in. .env is git-ignored; this file is the template.

# The v2 socket. Leave unset to use the dev proxy below (same-origin), or set it
# to an absolute wss:// URL for a static build served from another origin.
#   local backend   ws://127.0.0.1:8000/api/v2/ws
#   hosted backend  wss://<your-deployment>/api/v2/ws
VITE_NODUS_WS_URL=

# Origin the vite dev server proxies /api to. Defaults to the hosted deployment
# in vite.config.ts; point it at http://127.0.0.1:8000 to run against uvicorn.
NODUS_API_URL=

# Sent as ?api_key= on the handshake. Required only when the backend sets API_KEY.
VITE_NODUS_API_KEY=

# Set to 1 to start on the demo corpus and never open a socket.
VITE_NODUS_DEMO=
