# ---------------------------------------------------------------- database
# Hosted Postgres with pgvector enabled — Supabase, RDS, Neon, or your own.
# Note the +asyncpg driver: Nodus talks to Postgres asynchronously.
# In Supabase the extension is enabled once with:
#   create extension if not exists vector;
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
# auto = TLS for remote hosts only | require | disable
DATABASE_SSL=auto
# Connection pool. Keep pool_size + max_overflow under your provider's
# connection cap — Supabase's direct connection allows far fewer than a
# self-hosted Postgres.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------- llm provider
# azure (GPT-5.1) | anthropic | ollama
LLM_PROVIDER=azure

# Azure OpenAI behind API Management, authenticated with Entra ID client
# credentials plus an APIM subscription key.
LLM_AZURE_ENDPOINT=https://<apim-host>/<path>/<deployment-operation>
LLM_AZURE_API_VERSION=2025-04-01-preview
LLM_AZURE_TENANT_ID=
LLM_AZURE_CLIENT_ID=
LLM_AZURE_CLIENT_SECRET=
LLM_AZURE_SCOPE=<api-app-id>/.default
# APIM subscription key, sent as Ocp-Apim-Subscription-Key
LLM_API_KEY=
# Leave empty when the endpoint above already addresses the deployment (APIM
# style). Set it for classic https://<resource>.openai.azure.com endpoints.
LLM_AZURE_DEPLOYMENT=
LLM_AZURE_MODEL=gpt-5.1
# minimal | low | medium | high
LLM_AZURE_REASONING_EFFORT=low
# true when the endpoint is a single flat APIM operation (POST <endpoint>)
LLM_AZURE_FLAT_ROUTE=true

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXTRACTION_MODEL=mistral-nemo
OLLAMA_SYNTHESIS_MODEL=qwen2.5:32b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --------------------------------------------------------------- embeddings
# ollama = semantic (nomic-embed-text, 768d) — recommended
# azure  = Azure embedding deployment, forced to 768 dimensions
# hash   = deterministic local lexical fallback, no external service
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIM=768
LLM_AZURE_EMBEDDING_ENDPOINT=
LLM_AZURE_EMBEDDING_DEPLOYMENT=
LLM_AZURE_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- retrieval
# Without a key, relevance search returns 429 to every call and retrieval
# falls back to bulk search automatically. Request one at
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# Issued keys allow 1 request/second cumulative across all endpoints — the key
# buys a dedicated quota and relevance search, not a higher ceiling.
SEMANTIC_SCHOLAR_MIN_INTERVAL=1.1
# auto | relevance | bulk
RETRIEVAL_MODE=auto

# ----------------------------------------------------------------- pipeline
TOP_K_PAPERS=20
MAX_CONCURRENT_PAPERS=10
MAX_CLAIMS_PER_PAPER=12
FETCH_PDFS=true
PDF_MAX_BYTES=15000000
PDF_MAX_CHARS=60000
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------- analysis
CLUSTER_SIMILARITY_THRESHOLD=0.72
LEXICAL_CLUSTER_SIMILARITY_THRESHOLD=0.45
MAX_CLUSTERS_PER_QUERY=25
MIN_CLUSTER_SIZE=1

# ------------------------------------------------------- v2 streaming (ws)
# The progress hub is in-process: run the API with a single worker, or a client
# connected to one worker will not see runs started on another.
EVENT_REPLAY_MAX=500
EVENT_QUEUE_MAXSIZE=1000
# Idle keepalive on the v2 socket. Proxies often reap silent sockets at 30–60s.
WS_HEARTBEAT_SECONDS=15

# ----------------------------------------------------------- pdf export (v2)
# Headless Chromium renders the report. Install the browser once with:
#   uv run playwright install chromium
PDF_ENABLED=true
PDF_PAGE_FORMAT=A4
PDF_MARGIN=18mm
PDF_TIMEOUT_SECONDS=60
PDF_CACHE_SIZE=8

# --------------------------------------------------------------------- app
CORS_ORIGINS=["http://localhost:3000"]
# When set, every /api/v1 route requires this value in the X-API-Key header,
# and the /api/v2 socket requires it as a header or ?api_key= on the handshake.
API_KEY=
# Trust the OS certificate store for outbound HTTPS (needed behind TLS-
# inspecting proxies and antivirus HTTPS scanning).
USE_SYSTEM_CA=true
LOG_LEVEL=INFO
