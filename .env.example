# ---------------------------------------------------------------- database
# Hosted Postgres with pgvector enabled — Supabase, RDS, Neon, or your own.
# Note the +asyncpg driver: Nodus talks to Postgres asynchronously.
# In Supabase the extension is enabled once with:
#   create extension if not exists vector;
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
#
# Three Supabase endpoints, and the choice matters:
#   direct   db.<project>.supabase.co:5432                 <- the line above
#   session  aws-<n>-<region>.pooler.supabase.com:5432     <- IPv4-only hosts
#   txn      aws-<n>-<region>.pooler.supabase.com:6543     <- never: breaks asyncpg
#
# The direct host resolves to IPv6 only. From a runtime without IPv6 egress
# (Vercel, AWS Lambda) asyncpg fails with "[Errno 99] Cannot assign requested
# address" — use the session pooler there, whose username carries the project
# ref. Session mode keeps one backend connection per client connection, so
# prepared statements still work; transaction mode (6543) does not.
#   postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Copy the exact host from Supabase → Connect → Session pooler.
#
# auto = TLS for remote hosts only | require | disable
DATABASE_SSL=auto
# Connection pool. The number your provider sees is POOL_SIZE + MAX_OVERFLOW,
# not POOL_SIZE: SQLAlchemy opens an overflow connection whenever the pool is
# empty instead of waiting. Supabase's session pooler caps *clients* (15 by
# default) and refuses the one past the cap with
#   EMAXCONNSESSION: max clients reached in session mode
# which arrives mid-run as papers failing one after another. DB_MAX_CLIENTS is
# that cap; the sum above is clamped to it less DB_CLIENT_HEADROOM, so an
# oversized pool makes tasks wait on each other instead of being rejected.
# On serverless, every warm instance holds its own pool, so drop these to 1–2
# rather than multiplying the total by the instance count.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Seconds to wait for a pooled connection before failing.
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Your provider's client cap: 15 for Supabase's session pooler by default, far
# higher on the direct connection. 0 disables the clamp.
DB_MAX_CLIENTS=15
# Slots left for Alembic, psql, Supabase Studio and a redeploy's second instance.
DB_CLIENT_HEADROOM=3

# ------------------------------------------------------------- llm provider
# azure (GPT-5.1) | anthropic | ollama
LLM_PROVIDER=azure

# Azure OpenAI behind API Management, authenticated with Entra ID client
# credentials plus an APIM subscription key.
LLM_AZURE_ENDPOINT=https://<apim-host>/<path>/<deployment-operation>
LLM_AZURE_API_VERSION=2025-04-01-preview
LLM_AZURE_TENANT_ID=
LLM_AZURE_CLIENT_ID=
LLM_AZURE_CLIENT_SECRET=
LLM_AZURE_SCOPE=<api-app-id>/.default
# APIM subscription key, sent as Ocp-Apim-Subscription-Key
LLM_API_KEY=
# Leave empty when the endpoint above already addresses the deployment (APIM
# style). Set it for classic https://<resource>.openai.azure.com endpoints.
LLM_AZURE_DEPLOYMENT=
LLM_AZURE_MODEL=gpt-5.1
# minimal | low | medium | high
LLM_AZURE_REASONING_EFFORT=low
# true when the endpoint is a single flat APIM operation (POST <endpoint>)
LLM_AZURE_FLAT_ROUTE=true

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (used when LLM_PROVIDER=ollama, or EMBEDDING_PROVIDER=ollama).
# localhost is right for a laptop and impossible on a serverless host, which runs
# no sidecar and never reads docker-compose.yml — use EMBEDDING_PROVIDER=cloudflare
# there. Ollama authenticates nothing itself, so leave the token empty for a
# loopback server and set it for anything reachable over the network.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AUTH_TOKEN=
OLLAMA_EXTRACTION_MODEL=mistral-nemo
OLLAMA_SYNTHESIS_MODEL=qwen2.5:32b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --------------------------------------------------------------- embeddings
# cloudflare = Workers AI (bge-base-en-v1.5, 768d) — nothing to host, works from
#              a serverless deployment. Recommended.
# ollama     = semantic (nomic-embed-text, 768d), needs a reachable server
# azure      = Azure embedding deployment, forced to 768 dimensions
# hash       = deterministic local lexical fallback, no external service
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_DIM=768

# Cloudflare Workers AI. The model must be 768-wide to fit the claim_embeddings
# column: bge-base-en-v1.5 is 768, bge-large-en-v1.5 is 1024 and every vector
# would be discarded on write. /health/config reports the mismatch.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
# Point this at a Worker to keep the account token on Cloudflare's side.
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4

LLM_AZURE_EMBEDDING_ENDPOINT=
LLM_AZURE_EMBEDDING_DEPLOYMENT=
LLM_AZURE_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- retrieval
# Without a key, relevance search returns 429 to every call and retrieval
# falls back to bulk search automatically. Request one at
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# Issued keys allow 1 request/second cumulative across all endpoints — the key
# buys a dedicated quota and relevance search, not a higher ceiling.
SEMANTIC_SCHOLAR_MIN_INTERVAL=1.1
# auto | relevance | bulk
RETRIEVAL_MODE=auto

# ----------------------------------------------------------------- pipeline
TOP_K_PAPERS=20
MAX_CONCURRENT_PAPERS=10
MAX_CLAIMS_PER_PAPER=12
FETCH_PDFS=true
PDF_MAX_BYTES=15000000
PDF_MAX_CHARS=60000
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------- analysis
# One bar per embedding family: cosine similarity is not comparable across
# models, so a provider swap needs its own number. See active_cluster_threshold.
CLUSTER_SIMILARITY_THRESHOLD=0.72
LEXICAL_CLUSTER_SIMILARITY_THRESHOLD=0.45
BGE_CLUSTER_SIMILARITY_THRESHOLD=0.80
# Merges finished clusters whose centroids are this similar — the greedy pass
# never revisits a split, so one assertion can end up as two sections under the
# same heading. Sharp: 0.95 merges nothing, 0.90 cascades, 0.80 collapses the
# query. 1.0 is effectively off.
CLUSTER_MERGE_THRESHOLD=0.92
MAX_CLUSTERS_PER_QUERY=25
MIN_CLUSTER_SIZE=1

# ------------------------------------------------------- v2 streaming (ws)
# The progress hub is in-process: run the API with a single worker, or a client
# connected to one worker will not see runs started on another.
EVENT_REPLAY_MAX=500
EVENT_QUEUE_MAXSIZE=1000
# Idle keepalive on the v2 socket. Proxies often reap silent sockets at 30–60s.
WS_HEARTBEAT_SECONDS=15

# ----------------------------------------------------------- pdf export (v2)
# Headless Chromium renders the report. Install the browser once with:
#   uv run playwright install chromium
PDF_ENABLED=true
PDF_PAGE_FORMAT=A4
PDF_MARGIN=18mm
PDF_TIMEOUT_SECONDS=60
PDF_CACHE_SIZE=8

# ------------------------------------------------------- admission control
# In-process (no Redis), so it assumes the single worker the progress hub
# already requires. See app/services/limits.py.
#
# Concurrent pipeline runs. Each run is tens of LLM calls and holds database
# sessions for minutes, so this caps both spend and pool use. Submissions past
# the limit get 429 immediately — nothing is queued.
MAX_ACTIVE_QUERIES=2
# Runs admitted per UTC day, charged on admission. 0 disables the ceiling.
MAX_DAILY_RUNS=0
RATE_LIMIT_ENABLED=true
# Pipeline submissions, follow-ups and report regeneration.
RATE_LIMIT_RUNS_PER_HOUR=10
RATE_LIMIT_RUNS_BURST=3
# Cluster and report edits.
RATE_LIMIT_EDITS_PER_MINUTE=30
RATE_LIMIT_EDITS_BURST=10
# Only enable behind a proxy that rewrites X-Forwarded-For (Cloudflare, nginx).
# With nothing in front, the header is caller-controlled and every request can
# claim a fresh identity, which defeats per-IP limiting entirely.
TRUST_FORWARDED_FOR=false

# --------------------------------------------------------------------- app
CORS_ORIGINS=["http://localhost:3000"]
# When set, every /api/v1 route requires this value in the X-API-Key header,
# and the /api/v2 socket requires it as a header or ?api_key= on the handshake.
API_KEY=
# Grants the inline wait=true pipeline path, sent as X-Admin-Key (or ?admin_key=
# on the socket). That path holds a request and its database session open for the
# whole run, so it is refused with 403 unless this is set. Leave it empty on a
# public deployment.
ADMIN_API_KEY=
# Trust the OS certificate store for outbound HTTPS (needed behind TLS-
# inspecting proxies and antivirus HTTPS scanning).
USE_SYSTEM_CA=true
LOG_LEVEL=INFO
