# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nodus

# LLM Provider: "anthropic" for prototyping, "ollama" for production
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Semantic Scholar (optional — increases rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXTRACTION_MODEL=mistral-nemo
OLLAMA_SYNTHESIS_MODEL=qwen2.5:32b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# App
CORS_ORIGINS=["http://localhost:3000"]
MAX_CONCURRENT_PAPERS=10
